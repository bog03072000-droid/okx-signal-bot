# === Telegram ===
TG_API_ID=你的_api_id
TG_API_HASH=твій_api_hash
# При Docker-деплої постав TG_SESSION_NAME=data/signal_bot_session (а не просто
# "signal_bot_session") — тоді .session-файл потрапляє у volume data/ і
# переживає перезбірку образу, замість генеруватись заново при кожному деплої
TG_SESSION_NAME=signal_bot_session
TG_CHANNEL_USERNAME=@назва_каналу_або_id

# Куди бот шле сповіщення про власні дії (можеш використати той самий акаунт, інший чат/бот)
TG_NOTIFY_CHAT_ID=

# === Telegram control-бот (окремий бот-акаунт, керування /status /stop /setlimit тощо) ===
# Створюється через @BotFather (/newbot) — це НЕ той самий акаунт, що TG_API_ID/TG_API_HASH вище
TG_BOT_TOKEN=
# Твій особистий Telegram user_id (не username!) — дізнатись напр. через @userinfobot
# Команди control-бота від будь-кого іншого ігноруються
TG_OWNER_USER_ID=

# === Claude API (для парсингу сигналів) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Solana гаманець ===
# НІКОЛИ не комітьте цей файл з реальним ключем у git!
# Бот торгує за USDT (SPL-токен, не native SOL) — гаманець має мати ОБИДВА:
#   - USDT — торговий капітал (той, яким бот купує/продає токени)
#   - трохи SOL (0.05-0.1 SOL вистачить надовго) — ВИКЛЮЧНО на комісії мережі.
#     Без SOL бот не відправить жодної транзакції, навіть маючи багато USDT.
SOLANA_PRIVATE_KEY=base58_приватний_ключ
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === OKX DEX API ===
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROJECT_ID=

# === Режим роботи ===
DRY_RUN=true
CHAIN=solana

# === Ризик-менеджмент ===
# MAX_POSITION_PCT — % балансу USDT на ОДНУ угоду; MAX_OPEN_POSITIONS — скільки
# таких позицій може бути відкрито одночасно. Разом вони задають максимальну
# частку балансу "під ризиком" одночасно: 5% на угоду × 5 позицій = до 25%
# балансу в ринку одночасно (за умови що всі 5 позицій відкриті паралельно).
MAX_POSITION_PCT=5.0
MAX_OPEN_POSITIONS=5
MAX_SLIPPAGE_PCT=3.0
MAX_PRICE_IMPACT_PCT=5.0
DAILY_LOSS_LIMIT_PCT=10.0
TRADE_COOLDOWN_SECONDS=30

# УВАГА: ці пороги суттєво ослаблені під конкретний тип каналу, який кидає
# коли на токенах віком у хвилини з капіталізацією $5-16к. Це кардинально
# підвищує ризик рагу/скаму порівняно з дефолтними консервативними
# значеннями (24год/$20к). Ladder stop-loss (-10%/-20%) — єдиний реальний
# захист від втрат при такому підході, а не сам скринінг.
# Консервативні значення за замовчуванням (якщо приберете ці два рядки або
# видалите значення): 24 і 20000 — див. core/config.py, _float() fallback.
MIN_TOKEN_AGE_HOURS=0.05
MIN_LIQUIDITY_USD=2000

MIN_SIGNAL_CONFIDENCE=0.7
DEFAULT_STOP_LOSS_PCT=25.0
DEFAULT_TAKE_PROFIT_PCT=100.0

# Максимальна допустима розбіжність між ціною тригера ladder-рівня
# (DexScreener) і реальною ціною виконання свопу (OKX quote). Якщо
# перевищено — своп на цьому циклі призупиняється, рівень НЕ позначається
# спрацьованим, перевірка повториться наступного циклу (2с).
MAX_PRICE_DIVERGENCE_PCT=5.0
