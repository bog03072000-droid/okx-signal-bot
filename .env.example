# === Telegram ===
TG_API_ID=你的_api_id
TG_API_HASH=твій_api_hash
# При Docker-деплої постав TG_SESSION_NAME=data/signal_bot_session (а не просто
# "signal_bot_session") — тоді .session-файл потрапляє у volume data/ і
# переживає перезбірку образу, замість генеруватись заново при кожному деплої
TG_SESSION_NAME=signal_bot_session
TG_CHANNEL_USERNAME=@назва_каналу_або_id

# Куди бот шле сповіщення про власні дії (можеш використати той самий акаунт, інший чат/бот)
TG_NOTIFY_CHAT_ID=

# === Telegram control-бот (окремий бот-акаунт, керування /status /stop /setlimit тощо) ===
# Створюється через @BotFather (/newbot) — це НЕ той самий акаунт, що TG_API_ID/TG_API_HASH вище
TG_BOT_TOKEN=
# Твій особистий Telegram user_id (не username!) — дізнатись напр. через @userinfobot
# Команди control-бота від будь-кого іншого ігноруються
TG_OWNER_USER_ID=

# === Claude API (для парсингу сигналів) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Solana гаманець ===
# НІКОЛИ не комітьте цей файл з реальним ключем у git!
SOLANA_PRIVATE_KEY=base58_приватний_ключ
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === OKX DEX API ===
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROJECT_ID=

# === Режим роботи ===
DRY_RUN=true
CHAIN=solana

# === Ризик-менеджмент ===
MAX_POSITION_PCT=2.0
MAX_OPEN_POSITIONS=8
MAX_SLIPPAGE_PCT=3.0
MAX_PRICE_IMPACT_PCT=5.0
DAILY_LOSS_LIMIT_PCT=10.0
TRADE_COOLDOWN_SECONDS=30
MIN_TOKEN_AGE_HOURS=24
MIN_LIQUIDITY_USD=20000
MIN_SIGNAL_CONFIDENCE=0.7
DEFAULT_STOP_LOSS_PCT=25.0
DEFAULT_TAKE_PROFIT_PCT=100.0
